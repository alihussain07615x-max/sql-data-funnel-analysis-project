--=========================================================================
-- Step 3: Funnel Building
-- Goal: Map the full user journey and calculate conversion rates
--       between each step of the funnel
--=========================================================================
-- Conversion Rate = Current Step Users / Previous Step Users * 100
--=========================================================================

WITH union_all AS  (
SELECT user_id,page,1 AS step_order FROM home_page_table
UNION ALL 
SELECT user_id,page,2 AS step_order FROM search_page_table 
UNION ALL 
SELECT user_id,page,3 AS step_order FROM payment_page_table
UNION ALL 
SELECT user_id,page,4 AS step_order FROM payment_confirmation_table
)
SELECT
step_order,
page,
COUNT( user_id) AS total_user,
CASE 
WHEN LAG(COUNT(user_id)) OVER(ORDER BY step_order) IS NULL THEN 100
ELSE  ROUND(( CAST(COUNT(user_id)AS float)/ CAST (LAG(COUNT(user_id)) OVER(ORDER BY step_order ) AS float) ) * 100, 2)
END AS conversion_rate
FROM union_all
GROUP BY page, step_order

--=========================================================================
-- Results
--=========================================================================
--  Step              Users    Conversion Rate
-- --------------------------------------------
--  Home             90,400        100%
--  Search           45,200         50%
--  Payment           6,030         13%
--  Confirmation        452         7.5%
---------------------------
-- Key Insight:
-- Overall conversion rate from Home to Confirmation is just 0.5%
-- Only 452 out of 90,400 users completed a purchase
--=========================================================================
